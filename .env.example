# Database (Neon Postgres recommended for prod; local Postgres or Docker for dev)
DATABASE_URL="postgresql://user:password@host:5432/corporate_letters?sslmode=require"

# Anthropic Claude API (for triage, enrichment, lesson generation)
ANTHROPIC_API_KEY="sk-ant-..."

# Beehiiv (newsletter publishing + monetization)
BEEHIIV_API_KEY=""
BEEHIIV_PUBLICATION_ID=""

# Public base URL of the deployed site (so source-document images resolve in the
# Beehiiv email body). Leave empty in dev — images are omitted from the newsletter.
SITE_URL=""

# Daily cron (Vercel). Set CRON_SECRET in the Vercel project env — Vercel signs
# cron requests with it and the /api/cron/daily route verifies it.
CRON_SECRET=""
# "true" = cron sends the post live (status=confirmed). Default/empty = create a
# Beehiiv DRAFT for human review before sending (recommended until you trust it).
CRON_AUTO_CONFIRM=""

# Optional: SEC EDGAR user-agent (required by EDGAR ToS)
SEC_USER_AGENT="The Leadership Letter research@example.com"

# Optional: CourtListener API token — raises RECAP discovery rate limit.
# Anonymous works for light use; get a free token at courtlistener.com/profile/api/
COURTLISTENER_API_TOKEN=""

# Vercel Blob (for re-hosting source PDFs)
BLOB_READ_WRITE_TOKEN=""

# Resend (newsletter delivery + magic-link login email)
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
RESEND_FROM="The Leadership Letter <daily@yourdomain.com>"

# Membership / Auth.js (magic-link login)
# Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_EMAIL_FROM="The Leadership Letter <login@yourdomain.com>"

# Stripe (Phase 2 — billing). Create the $3/mo and annual prices, then set their IDs.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
